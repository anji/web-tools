---
import Base from '../layouts/Base.astro';
import { registry } from '../registry';

const { brand } = registry;
const categories = registry.categories();

const websiteSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: brand.name,
  url: brand.origin,
  description: brand.description,
});

const appSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: brand.name,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Any (web browser)',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  featureList: registry.tools.map((tool) => tool.label),
});

const promises = [
  { title: 'Nothing is uploaded', body: 'Every tool is a pure function running in your tab. Open the network panel and watch it stay empty.' },
  { title: 'No account, no limits', body: 'No sign-up, no file count, no watermark, no "upgrade to convert more than 3 files".' },
  { title: 'Works offline', body: 'Load the page once and it keeps working with the network off. That is the proof, not the marketing.' },
];
---

<Base
  title={`${brand.name} — ${brand.tagline}`}
  description={brand.description}
  path="/"
  schemas={[websiteSchema, appSchema]}
>
  <section class="border-b border-slate-800/80">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:py-24">
      <h1 class="max-w-3xl text-4xl font-bold tracking-tight text-slate-50 sm:text-5xl">
        JSON tools that never see your data
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-400">
        Format it, turn it into TypeScript or Zod, diff two API responses, query it with JSONPath,
        or strip the secrets out before you paste it into a ticket. Everything runs in your browser —
        no upload, no account, no limits.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/json-formatter/"
          class="rounded-md bg-sky-500 px-5 py-2.5 text-sm font-semibold text-slate-950 transition hover:bg-sky-400"
        >
          Format some JSON
        </a>
        <a
          href="/json-to-typescript/"
          class="rounded-md border border-slate-700 px-5 py-2.5 text-sm font-semibold text-slate-200 transition hover:border-slate-500"
        >
          Generate TypeScript
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14">
    {categories.map((category) => (
      <div class="mb-12">
        <h2 class="mb-5 text-sm font-semibold uppercase tracking-wider text-slate-500">
          {category.name}
        </h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {category.tools.map((tool) => (
            <a
              href={`/${tool.slug}/`}
              class="group rounded-lg border border-slate-800 bg-slate-900/40 p-5 transition hover:border-sky-800 hover:bg-slate-900"
            >
              <h3 class="font-semibold text-slate-100 transition group-hover:text-sky-400">
                {tool.label}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-400">{tool.blurb}</p>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>

  <section class="border-t border-slate-800/80 bg-slate-900/30">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-14 sm:grid-cols-3">
      {promises.map((promise) => (
        <div>
          <h2 class="font-semibold text-slate-100">{promise.title}</h2>
          <p class="mt-2 text-sm leading-relaxed text-slate-400">{promise.body}</p>
        </div>
      ))}
    </div>
  </section>
</Base>
